[
  {
    "name": "eq_update",
    "patterns": [
      {
        "pattern": "^Your equipment [[]brief mode[]]:$",
        "type": "regex"
      }
    ],
    "fireLength": "1",
    "children": [
      {
        "name": "eq_line",
        "patterns": [
          {
            "pattern": "^[A-Z][a-z ]+[a-z][:] .+$",
            "type": "regex"
          },
          {
            "pattern": "^Nothing\\.$",
            "type": "regex"
          }
        ]
      }
    ]
  },
  {
    "name": "eq_slots_start",
    "patterns": [
      {
        "pattern": "^Your current (armour) status is:$",
        "type": "regex"
      },
      {
        "pattern": "^Your current (limb) status is:$",
        "type": "regex"
      }
    ],
    "fireLength": "1",
    "children": [
      {
        "name": "eq_slots",
        "patterns": [
          {
            "pattern": "^  You have ([a-z]+) free ([a-z]+) slots?$",
            "type": "regex"
          }
        ]
      },
      {
        "name": "eq_limbs",
        "patterns": [
          {
            "pattern": "^(upper |lower )?(right|left) (hand|paw|wing)[ ]+(.+)$",
            "type": "regex"
          }
        ]
      },
      {
        "name": "eq_empty",
        "patterns": [
          {
            "pattern": "^$",
            "type": "regex"
          }
        ]
      }
    ]
  },
  {
    "name": "eq_done",
    "patterns": [
      {
        "pattern": "^[A-Z][a-z]+ is not idle[.]$",
        "type": "regex"
      }
    ]
  },
  {
    "name": "eq_changed",
    "patterns": [
      {
        "pattern": "^You (wear|remove|wield|sheath|unsheath) .*",
        "type": "regex"
      }
   ]
  }
]
