[
  {
    "name": "Update equipment",
    "patterns": [
      {
        "pattern": "^Your equipment [[]brief mode[]]:$",
        "type": "regex"
      }
    ],
    "fireLength": "45",
    "children": [
      {
        "name": "eq line",
        "patterns": [
          {
            "pattern": "^[A-Z][a-z ]+[a-z][:] .+$",
            "type": "regex"
          }
        ]
      },
      {
        "name": "eq done",
        "patterns": [
          {
            "pattern": "^[A-Z][a-z]+ is not idle[.]$",
            "type": "regex"
          }
        ]
      },
      {
        "name": "slots",
        "patterns": [
          {
            "pattern": "^  You have ([a-z]+) free ([a-z]+) slots?$",
            "type": "regex"
          }
        ]
      },
      {
        "name": "limbs",
        "patterns": [
          {
            "pattern": "^(upper |lower )?(right|left) (hand|paw)[ ]+(.+)$",
            "type": "regex"
          }
        ]
      },
      {
        "name": "slots start",
        "patterns": [
          {
            "pattern": "^Your current (armour) status is:$",
            "type": "regex"
          },
          {
            "pattern": "^Your current (limb) status is:$",
            "type": "regex"
          }
        ]
      },
      {
        "name": "empty",
        "patterns": [
          {
            "pattern": "^$",
            "type": "regex"
          }
        ],
        "script": "deleteLine()"
      }
    ]
  },
  {
    "name": "Equipment changed",
    "patterns": [
      {
        "pattern": "^You (wear|remove|wield|sheath|unsheath) .*",
        "type": "regex"
      }
   ]
  }
]
