[
  {
    "name": "tick",
    "patterns": [
      {
        "pattern": "^TICK: ([-+][0-9]+)?[/]([-+][0-9]+)?[/]([-+][0-9]+)?[ ]*$",
        "type": "regex"
      }
    ]
  },
  {
    "name": "stats",
    "patterns": [
      {
        "pattern": "^EQ:([a-z0-9]+)[ ]+STATS: ([A-Za-z]+)/([A-Za-z]+)/([0-9]+)+/([-]?[0-9]+)/([-]?[0-9]+)/([-]?[0-9]+)/([-]?[0-9]+)/([-]?[0-9]+)/([-]?[0-9]+)/([-]?[0-9]+)/([0-9]*)/([-A-Za-z' ]+)/([-]?[0-9]+)/([A-Za-z ]+)/$",
        "type": "regex"
      }
    ]
  },
  {
    "name": "stuff",
    "patterns": [
      {
        "pattern": "^STUFF: ([0-9]+)/([0-9]+)/([0-9]+)/([0-9]+)/([0-9]+)/([^/]*)/([^/]*)/$",
        "type": "regex"
      }
    ]
  },
  {
    "name": "points",
    "patterns": [
      {
        "pattern": "^H:([-]?[0-9]+)[/]([-]?[0-9]+)[ ]+S:([-]?[0-9]+)[/]([-]?[0-9]+)[ ]+E:([-]?[0-9]+)[/]([-]?[0-9]+)[ ]+WHEREAMI: ([A-z]+) (-?[0-9]+),(-?[0-9]+)$",
        "type": "regex"
      }
    ]
  }
]